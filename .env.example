# Basis-URL der Seite — bestimmt Canonicals, hreflang, Sitemap und robots.txt.
# Ohne diesen Wert nutzt der Build die Vercel-Produktionsdomain,
# lokal fällt er auf http://localhost:3100 zurück.
NEXT_PUBLIC_SITE_URL=https://www.mkp-polska.pl

# Indexierung. Ohne Wert gilt: nur die Vercel-Produktionsumgebung wird indexiert,
# Preview-Deployments bleiben auf noindex.
#   true  = immer indexieren (auch Preview)
#   false = nie indexieren (auch Produktion)
# NEXT_PUBLIC_ALLOW_INDEXING=true
